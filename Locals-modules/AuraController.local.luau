		for i, v in ipairs(list) do
			local v1 = t[v]

			if v1 then
				v1.Maid:Cleanup()
				t[v] = nil
				t2[v] = nil

				continue
			end

			t2[v] = nil
		end
	end), "Disconnect")
end)

if ok then
	return
end

warn("[AuraController] init failed: " .. tostring(result))