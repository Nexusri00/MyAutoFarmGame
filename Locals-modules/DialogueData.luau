		Standing1 = "<font color=\"rgb(32,177,255)\">Proselyte.</font> The Device beeped once, and you answered. Restore the Caduceus.",
		Standing2 = "<font color=\"rgb(32,177,255)\">Messenger.</font> Three debts honored. The Prescripts trust your hands now.",
