	["Index Messenger Lore"] = {
		[1] = "Long before you, the <font color=\"rgb(32,177,255)\">House of Spiders</font> wove its threads through every alley of every city. At its head sat the Nursefather -- Rien -- and nine instruments hung at his back.",
		[2] = "He carried a Device the House called <font color=\"rgb(32,177,255)\">Caduceus</font>. It writes Prescripts: orders that may not be refused. Whom to spare. Whom to cut. He fulfilled every one without asking why.",
		[3] = "Then the Device wrote a Prescript even he could not carry, and the House went quiet. The mask burned. The instruments went still. Everyone assumed the story ended there.",
		[4] = "But the Device never stopped writing. And last night, for the first time since the Nursefather fell, it printed a name. <font color=\"rgb(32,177,255)\">Yours.</font> Take it -- or the beeping never stops. There was never really a choice.",
		Choice = {
			{
				{ "Go on", "Next" },
