local function buildIndices(p1, p2) --[[ buildIndices | Line: 66 ]]
	local t = {}
	local t2 = {}

	for i, v in ipairs(p1) do
		if t[v.Id] ~= nil then
			error(("DungeonShopData.%s: duplicate Id \'%s\'"):format(p2, v.Id), 0)
		end

		if t2[v.Item] ~= nil then
			error(("DungeonShopData.%s: duplicate Item \'%s\'"):format(p2, v.Item), 0)
		end

		t[v.Id] = v
		t2[v.Item] = v
	end

	return t2, t
end

